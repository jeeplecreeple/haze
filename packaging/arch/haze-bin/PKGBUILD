# Installs the prebuilt release binary (no compiling). Ready for the AUR as "haze-bin".
# Needs the GitHub repo to be public so the release download works without a login.
# Maintainer: Haz
pkgname=haze-bin
_pkgname=haze
pkgver=0.5.0
pkgrel=1
pkgdesc="Native, lightweight, customisable Spotify client with an AI DJ (prebuilt)"
arch=('x86_64' 'aarch64')
url="https://github.com/jeeplecreeple/haze"
license=('MIT')
depends=('alsa-lib' 'libxkbcommon' 'libxkbcommon-x11' 'gcc-libs' 'glibc')
optdepends=('espeak-ng: spoken DJ intros with the system voice'
            'speech-dispatcher: alternative system voice for spoken DJ intros'
            'vulkan-icd-loader: GPU renderer (renderer = "gpu")'
            'xdg-desktop-portal-gtk: file picker for custom icons, covers and fonts')
provides=("$_pkgname")
conflicts=("$_pkgname")
source_x86_64=("$_pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/haze-linux-x86_64.tar.gz")
source_aarch64=("$_pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/haze-linux-arm64.tar.gz")
# Run `updpkgsums` after each release to fill these in.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "$srcdir/$_pkgname"
  install -Dm755 haze "$pkgdir/usr/bin/haze"
  install -Dm644 haze.desktop "$pkgdir/usr/share/applications/haze.desktop"
  install -Dm644 haze.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/haze.png"
  install -Dm644 haze.png "$pkgdir/usr/share/pixmaps/haze.png"
  install -Dm644 config.example.toml GUIDE.md README.md -t "$pkgdir/usr/share/doc/$_pkgname/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
}
