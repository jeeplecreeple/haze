# Builds Haze from the checkout this file sits in, so it also works while the repo is private:
#   git clone https://github.com/jeeplecreeple/haze
#   cd haze/packaging/arch
#   makepkg -Csi
# Maintainer: Haz
pkgname=haze
pkgver=0.5.2
pkgrel=1
pkgdesc="Native, lightweight, customisable Spotify client with an AI DJ"
arch=('x86_64' 'aarch64')
url="https://github.com/jeeplecreeple/haze"
license=('MIT')
depends=('alsa-lib' 'libxkbcommon' 'libxkbcommon-x11' 'gcc-libs' 'glibc')
optdepends=('espeak-ng: spoken DJ intros with the system voice'
            'speech-dispatcher: alternative system voice for spoken DJ intros'
            'vulkan-icd-loader: GPU renderer (renderer = "gpu")'
            'xdg-desktop-portal-gtk: file picker for custom icons, covers and fonts')
makedepends=('cargo')
options=('!lto' '!debug')
source=()
sha256sums=()

_root() {
  realpath "$startdir/../.."
}

prepare() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  cd "$(_root)"
  install -Dm755 "$srcdir/target/release/haze" "$pkgdir/usr/bin/haze"
  install -Dm644 packaging/linux/haze.desktop "$pkgdir/usr/share/applications/haze.desktop"
  install -Dm644 assets/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/haze.png"
  install -Dm644 assets/icon.png "$pkgdir/usr/share/pixmaps/haze.png"
  install -Dm644 config.example.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
  install -Dm644 GUIDE.md README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
